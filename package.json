{
  "name": "checkin",
  "private": true,
  "version": "2.2.0",
  "description": "CheckIn Desktop Application",
  "main": "dist-electron/main.js",
  "author": "FTH",
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && concurrently -k \"vite\" \"wait-on tcp:5173 && node scripts/start-electron.js\"",
    "dev:novel": "cross-env CHECKIN_EDITION=novel node scripts/ensure-electron.mjs && concurrently -k \"cross-env CHECKIN_EDITION=novel vite\" \"wait-on tcp:5173 && node scripts/start-electron.js\"",
    "dev:debug": "node scripts/ensure-electron.mjs && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_OPEN_DEVTOOLS=1 node scripts/start-electron.js\"",
    "dev:debug:log": "node scripts/ensure-electron.mjs && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_OPEN_DEVTOOLS=1 CHECKIN_ACTIVITY_DEBUG=1 node scripts/start-electron.js\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "node scripts/ensure-electron.mjs && concurrently -k \"vite\" \"wait-on tcp:5173 && node scripts/start-electron.js\"",
    "electron:build": "tsc -b && vite build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder",
    "electron:build:dir": "tsc -b && vite build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --dir",
    "electron:build:lite": "tsc -b && cross-env CHECKIN_EDITION=lite vite build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder",
    "electron:build:novel": "tsc -b && cross-env CHECKIN_EDITION=novel vite build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder",
    "electron:preview": "vite build && electron .",
    "electron:setup": "pnpm install && pnpm ensure:electron",
    "typecheck": "tsc -b",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "fix:deps": "node scripts/fix-pnpm-links.mjs",
    "check:deps": "node scripts/fix-pnpm-links.mjs --check",
    "analyze:asar": "node scripts/analyze-asar.mjs",
    "postinstall": "node scripts/fix-pnpm-links.mjs --check --warn-only && node scripts/ensure-electron.mjs --timeout-ms=600000"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "docx": "^9.5.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.11.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.2.5",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-force": "3.0.10",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@xyflow/react": "12.12.0",
    "antd": "^6.6.2",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "d3-force": "3.0.0",
    "dayjs": "^1.11.21",
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "framer-motion": "^12.23.12",
    "globals": "^17.6.0",
    "jsdom": "^27.1.0",
    "lunar-typescript": "^1.8.6",
    "marked": "^18.0.7",
    "rcedit": "^5.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "react-virtuoso": "^4.18.13",
    "sass": "^1.101.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.0.16",
    "wait-on": "^9.0.10",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.checkin.app",
    "productName": "CheckIn",
    "icon": "public/icon.ico",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "compression": "maximum",
    "afterPack": "./scripts/after-pack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "dist-electron",
        "to": "dist-electron",
        "filter": [
          "**/*"
        ]
      },
      "!node_modules/**/*.map",
      "!node_modules/**/*.md",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/{test,tests,__tests__,spec,docs,example,examples,benchmark}/**",
      "!node_modules/@types/**",
      "!node_modules/better-sqlite3/{deps,src}/**",
      "!node_modules/better-sqlite3/prebuilds/darwin-*.node",
      "!node_modules/better-sqlite3/prebuilds/linux-*.node",
      "!node_modules/better-sqlite3/prebuilds/linuxmusl-*.node",
      "!node_modules/better-sqlite3/prebuilds/win32-arm64.node",
      "!**/node_modules/@types/**",
      "!node_modules/node-addon-api/**",
      "!node_modules/docx/dist/index.iife.js",
      "!node_modules/docx/dist/index.mjs",
      "!node_modules/docx/dist/index.umd.cjs",
      "!node_modules/docx/node_modules/**",
      "!node_modules/mammoth/mammoth.browser.js",
      "!node_modules/mammoth/mammoth.browser.min.js",
      "!node_modules/jszip/dist/**",
      "!node_modules/pako/dist/**",
      "!node_modules/bluebird/js/browser/**",
      "!node_modules/xml-js/dist/**",
      "!node_modules/underscore/{modules,cjs}/**",
      "!node_modules/underscore/underscore-esm.js",
      "!node_modules/underscore/underscore-esm-min.js",
      "!node_modules/underscore/underscore-umd-min.js",
      "!node_modules/underscore/underscore-min.js",
      "!node_modules/underscore/underscore.js"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/prebuilds/win32-x64.node"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
