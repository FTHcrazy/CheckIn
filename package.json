{
  "name": "checkin",
  "private": true,
  "version": "1.9.3",
  "description": "CheckIn Desktop Application",
  "main": "dist-electron/main.js",
  "author": "FTH",
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && concurrently -k \"vite\" \"wait-on tcp:5173 && node scripts/start-electron.js\"",
    "dev:debug": "node scripts/ensure-electron.mjs && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_OPEN_DEVTOOLS=1 node scripts/start-electron.js\"",
    "dev:debug:log": "node scripts/ensure-electron.mjs && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_OPEN_DEVTOOLS=1 CHECKIN_ACTIVITY_DEBUG=1 node scripts/start-electron.js\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "node scripts/ensure-electron.mjs && concurrently -k \"vite\" \"wait-on tcp:5173 && node scripts/start-electron.js\"",
    "electron:build": "tsc -b && vite build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder",
    "electron:build:dir": "tsc -b && vite build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --dir",
    "electron:preview": "vite build && electron .",
    "electron:rebuild": "node scripts/rebuild-native.mjs",
    "electron:setup": "pnpm install && pnpm ensure:electron && pnpm electron:rebuild",
    "typecheck": "tsc -b",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "fix:deps": "node scripts/fix-pnpm-links.mjs",
    "check:deps": "node scripts/fix-pnpm-links.mjs --check",
    "postinstall": "node scripts/fix-pnpm-links.mjs --check --warn-only && node scripts/ensure-electron.mjs --timeout-ms=600000"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "antd": "^6.6.2",
    "better-sqlite3": "^12.11.1",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.21",
    "docx": "^9.5.1",
    "framer-motion": "^12.23.12",
    "lunar-typescript": "^1.8.6",
    "mammoth": "^1.11.0",
    "marked": "^18.0.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "react-virtuoso": "^4.18.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^27.1.0",
    "sass": "^1.101.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.0.16",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.checkin.app",
    "productName": "CheckIn",
    "icon": "public/icon.png",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "compression": "maximum",
    "afterPack": "./scripts/after-pack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "dist-electron",
        "to": "dist-electron",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
